# Copy to .env for LOCAL runs. Never commit .env.
#
# On a public deployment (e.g. a Hugging Face Space) leave these three
# unset: every visitor then enters their own keys in the app. If you do
# set them on the host, every visitor uses - and spends - YOUR keys.
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# --- Optional settings (defaults shown) ---
# Where the app stores ingested papers, vectors and temp files.
# On a Hugging Face Space with persistent storage, use /data.
# SMARTPAPER_DATA_DIR=./data

# Models. Change these when a provider retires a model; the key check
# in the app reports a configured model that is no longer offered.
# SMARTPAPER_OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# SMARTPAPER_GROQ_MODEL=openai/gpt-oss-120b
# SMARTPAPER_GEMINI_MODEL=gemini-2.5-flash

# Figures per paper the vision model may describe at upload, to enrich
# search. 0 = index figures by caption only (no API calls). Gemini's
# free tier allows only ~20 requests a day, so leave this at 0 unless
# visitors' keys are on a paid tier.
# SMARTPAPER_VISION_SUMMARY_BUDGET=0

# Limits.
# SMARTPAPER_MAX_UPLOAD_MB=20      (also change maxUploadSize in .streamlit/config.toml)
# SMARTPAPER_MAX_PDF_PAGES=50
# SMARTPAPER_MAX_STORED_PAPERS=50
# SMARTPAPER_TOP_K=6
# SMARTPAPER_AGENT_TIMEOUT=45      seconds before a question falls back from OpenRouter to Groq
